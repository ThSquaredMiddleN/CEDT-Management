# Local Postgres (no Docker). Use your OS user for a Homebrew install with trust auth,
# e.g. postgresql://$USER@localhost:5432/labsync?schema=public
DATABASE_URL="postgresql://localhost:5432/labsync?schema=public"
PORT=3000
NODE_ENV=development
APP_ORIGIN="http://localhost:5173"
SESSION_COOKIE_NAME="labsync_session"
SESSION_TTL_HOURS=168
APP_TZ="Asia/Bangkok"
