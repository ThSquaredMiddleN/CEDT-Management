# Local Postgres (no Docker). Use your OS user for a Homebrew install with trust auth,
# e.g. postgresql://$USER@localhost:5432/labsync?schema=public
DATABASE_URL="postgresql://localhost:5432/labsync?schema=public"
PORT=3000
NODE_ENV=development
APP_ORIGIN="http://localhost:5173"
SESSION_COOKIE_NAME="labsync_session"
SESSION_TTL_HOURS=168
APP_TZ="Asia/Bangkok"

# Receipt checks: the Python OCR sidecar (prototype-1/ocr-service) on localhost.
# The timeout covers one upload end to end (screenshots run OCR, which can be slow on CPU).
OCR_SERVICE_URL="http://127.0.0.1:8790"
OCR_TIMEOUT_MS=90000
# Receipt check rows older than this are deleted by `npm run receipts:purge`.
RECEIPT_RETENTION_DAYS=365
