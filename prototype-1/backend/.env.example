# Local Postgres (no Docker). Use your OS user for a Homebrew install with trust auth,
# e.g. postgresql://$USER@localhost:5432/labsync?schema=public
DATABASE_URL="postgresql://localhost:5432/labsync?schema=public"
PORT=3000
NODE_ENV=development
APP_ORIGIN="http://localhost:5173"
SESSION_COOKIE_NAME="labsync_session"
SESSION_TTL_HOURS=168
APP_TZ="Asia/Bangkok"

# LINE notifications (optional). The secret plus the token (or LINE_DRY_RUN) enables LINE.
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# Local only: print LINE replies and pushes to the console instead of sending them (no LINE account needed).
# LINE_DRY_RUN=true
# LINE_LINK_TTL_MINUTES=15
# LINE_DISPATCH_INTERVAL_MS=5000
