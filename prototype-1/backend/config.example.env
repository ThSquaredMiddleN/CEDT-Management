# Copy to .env and replace the database credentials for your local machine.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/labsync?schema=public"
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
APP_TZ=Asia/Bangkok
SESSION_COOKIE_NAME=labsync_session
SESSION_TTL_HOURS=168
# Optional demo date only; leave empty to use today's date in Bangkok.
COURSE_CHANGE_TODAY=
