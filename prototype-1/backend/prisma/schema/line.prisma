/// A user's linked LINE account (owned by the LINE module). One LINE ID belongs to at most one user.
model LineAccount {
  userId     String   @id @map("user_id") @db.Uuid
  lineUserId String   @unique @map("line_user_id")
  linkedAt   DateTime @map("linked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("line_accounts")
}

/**
 * One-time link from a LINE user ID to the app login. Only the sha256 of the raw token is stored.
 */
model LineLinkToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  lineUserId String    @map("line_user_id")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([lineUserId])
  @@map("line_link_tokens")
}

/// Dedupe row per LINE webhook event. Written before the handler runs; handledAt is set only after the handler
/// succeeds. A row with handledAt null means the event has not finished, so a redelivery runs it again.
model LineWebhookEvent {
  webhookEventId String    @id @map("webhook_event_id")
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  handledAt      DateTime? @map("handled_at") @db.Timestamptz(6)

  @@map("line_webhook_events")
}
