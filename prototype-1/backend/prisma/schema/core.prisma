model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique @db.Citext
  /// Null for accounts that sign in through MCV only; password login then fails.
  passwordHash     String?   @map("password_hash")
  name             String
  titlePrefix      String?   @map("title_prefix")
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  /// Set = this user is a student. 10 digits (CHECK in migration).
  studentNo        String?   @unique @map("student_no") @db.Char(10)
  /// This user's id in MCV (set on first MCV login).
  mcvId            String?   @unique @map("mcv_id")
  advisorId        String?   @map("advisor_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  bookingsInstructing Booking[]      @relation("instructor")
  bookingsRequested   Booking[]      @relation("requestedBy")
  bookingsDecided     Booking[]      @relation("decidedBy")
  defaultForCourses   Course[]
  events              BookingEvent[]
  notifications       Notification[]
  receiptChecks       ReceiptCheck[]
  announcements       Announcement[]
  newsArticles        NewsArticle[]
  groupsCreated       Group[]
  auditLogs           AuditLog[]
  lineAccount         LineAccount?
  filesUploaded       File[]         @relation("filesUploaded")

  advisor                      User?                        @relation("advisor", fields: [advisorId], references: [id], onDelete: Restrict)
  advisees                     User[]                       @relation("advisor")
  enrollments                  Enrollment[]
  courseChangeRequests         CourseChangeRequest[]        @relation("ccStudent")
  courseChangeDecided          CourseChangeRequest[]        @relation("ccDecidedBy")
  courseChangeEvents           CourseChangeEvent[]
  courseChangeSettingsEvents   CourseChangeSettingsEvent[]
  courseChangeFilesUploaded    CourseChangeFile[]
  courseChangeSignatureBatches CourseChangeSignatureBatch[]

  roles              UserRoleAssignment[] @relation("userRoles")
  rolesGranted       UserRoleAssignment[] @relation("rolesGranted")
  permissions        UserPermission[]     @relation("userPermissions")
  permissionsGranted UserPermission[]     @relation("permissionsGranted")

  @@index([isActive])
  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Course {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String  @unique
  name                String
  defaultInstructorId String? @map("default_instructor_id") @db.Uuid
  isActive            Boolean @default(true) @map("is_active")
  /// Where the course record comes from. "cedt-google-forms" = the CEDT drop/withdraw form
  /// catalog (docs/course-change/DATABASE.md). Null = LabSync booking course (e.g. legacy
  /// CEDT101 placeholders), which Course Change ignores.
  catalogSource       String? @map("catalog_source")

  defaultInstructor            User?                        @relation(fields: [defaultInstructorId], references: [id])
  bookings                     Booking[]
  enrollments                  Enrollment[]
  groups                       Group[]
  allowedCourses               AllowedCourse[]
  courseChangeRequests         CourseChangeRequest[]
  courseChangeSchedules        CourseChangeSchedule[]
  courseChangeSignatureBatches CourseChangeSignatureBatch[]

  @@map("courses")
}

model Term {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYear Int      @map("academic_year")
  termNumber   Int      @map("term_number") @db.SmallInt
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  isActive     Boolean  @default(false) @map("is_active")

  bookings                     Booking[]
  courseChangeWindows          CourseChangeWindow[]
  enrollments                  Enrollment[]
  groups                       Group[]
  allowedCourses               AllowedCourse[]
  courseChangeRequests         CourseChangeRequest[]
  courseChangeSettingsEvents   CourseChangeSettingsEvent[]
  courseChangeSchedules        CourseChangeSchedule[]
  courseChangeSignatureBatches CourseChangeSignatureBatch[]

  @@unique([academicYear, termNumber])
  @@map("terms")
}

/// One row per recipient. `type` is "<module>.<event>" (checked in core/notify.ts); no FK to the subject,
/// so deletes of a subject must remove its rows by module + subjectId.
model Notification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  type             String
  module           String
  /// Id of the thing notified about (e.g. a booking id), stored as text.
  subjectId        String?   @map("subject_id")
  /// Readable without opening the web app; LINE sends this text as-is.
  message          String
  /// In-app path such as "/requests", never a full URL.
  link             String?
  payload          Json      @default("{}")
  /// false keeps the row in-app only: the LINE dispatcher skips it.
  sendLine         Boolean   @default(true) @map("send_line")
  isRead           Boolean   @default(false) @map("is_read")
  readAt           DateTime? @map("read_at") @db.Timestamptz(6)
  deliveredLineAt  DateTime? @map("delivered_line_at") @db.Timestamptz(6)
  deliveredEmailAt DateTime? @map("delivered_email_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([module, subjectId])
  @@index([deliveredLineAt])
  @@map("notifications")
}

/// Append-only history of business changes (team plan 3.6). UPDATE, DELETE and TRUNCATE are blocked by triggers
/// in the migration. `action` is "<module>.<thing>.<verb>" (checked in core/audit.ts); secrets are stripped there too.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorId     String?  @map("actor_id") @db.Uuid // ว่างถ้าระบบเป็นผู้ทำ เช่น งานลบตาม retention
  module      String
  action      String // "<module>.<สิ่งของ>.<การกระทำ>" เช่น "storage.request.approved"
  subjectType String   @map("subject_type") // "storage_request"
  subjectId   String   @map("subject_id")
  before      Json?
  after       Json?
  note        String? // เช่น จำนวนแถวที่ลบตาม retention
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId, createdAt])
  @@index([actorId, createdAt])
  @@index([module, createdAt])
  @@map("audit_logs")
}

/// A student's registration in a course (mirrors Reg Chula; seeded in the prototype). Shared by every module.
model Enrollment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  termId    String   @map("term_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  /// Null when unknown — demo data never invents official sections or credits.
  section   String?
  credits   Int?     @db.SmallInt
  /// Provenance, e.g. "synthetic-demo". A future Reg Chula sync would write its own value.
  source    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student User   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term    Term   @relation(fields: [termId], references: [id], onDelete: Restrict)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, termId, courseId])
  @@index([termId, courseId, section])
  @@map("enrollments")
}

enum GroupType {
  /// A group inside a course section, e.g. "Group 09". Needs course and term (CHECK in migration).
  course_section
  club
  project
  personal

  @@map("group_type")
}

enum GroupMemberRole {
  member
  leader

  @@map("group_member_role")
}

model Group {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        GroupType
  name        String
  /// lower-cased, trimmed, inner spaces collapsed; unique per term/course/section
  nameKey     String    @map("name_key")
  courseId    String?   @map("course_id") @db.Uuid
  termId      String?   @map("term_id") @db.Uuid
  section     String?
  /// Null when the group came from a CSV import.
  createdById String?   @map("created_by") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  course    Course?       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  term      Term?         @relation(fields: [termId], references: [id], onDelete: Restrict)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members   GroupMember[]

  @@unique([termId, courseId, section, nameKey])
  @@index([type, isActive])
  @@map("groups")
}

/// Members are stored by student number, not user id: CSV imports come before the student's first login.
/// Match to users.student_no on read (no FK).
model GroupMember {
  groupId   String          @map("group_id") @db.Uuid
  studentNo String          @map("student_no") @db.Char(10)
  role      GroupMemberRole @default(member)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([groupId, studentNo])
  @@index([studentNo])
  @@map("group_members")
}

/// A named set of permissions (a preset that stays attached to its users). Never deleted:
/// is_active = false. System roles come from migrations; their key cannot change.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// e.g. "it_admin", "student", "teacher". ^[a-z][a-z0-9_]{1,40}$
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

model RolePermission {
  roleId     String   @map("role_id") @db.Uuid
  /// A name some module declares in code (see permissionCatalog).
  permission String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

/// user_roles. Named UserRoleAssignment so it does not clash with the old UserRole enum.
/// The "student" role is never stored here: it comes from users.student_no.
model UserRoleAssignment {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedById String?  @map("granted_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User  @relation("userRoles", fields: [userId], references: [id], onDelete: Restrict)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("rolesGranted", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// A permission given to one person directly (add-only, no deny). A reason is required.
model UserPermission {
  userId      String   @map("user_id") @db.Uuid
  permission  String
  reason      String
  grantedById String?  @map("granted_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User  @relation("userPermissions", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("permissionsGranted", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([userId, permission])
  @@map("user_permissions")
}

/// File metadata (shared plan 3.7). Contents live in fileStore, never in the database.
/// Write only through src/core/files.ts. Module tables point here with file_id.
model File {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "<year>/<month>/<uuid>" in the local folder or the bucket.
  storageKey   String   @unique @map("storage_key")
  originalName String   @map("original_name")
  mime         String
  /// Bytes.
  size         Int
  sha256       String   @db.Char(64)
  module       String
  uploadedById String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploadedBy       User?             @relation("filesUploaded", fields: [uploadedById], references: [id], onDelete: Restrict)
  courseChangeFile CourseChangeFile?
  newsImage        NewsImage?

  @@index([module, createdAt])
  @@map("files")
}
