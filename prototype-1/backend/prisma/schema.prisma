generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist, pgcrypto]
}

enum UserRole {
  staff

  @@map("user_role")
}

enum RoomType {
  lecture
  lab
  hardware
  meeting

  @@map("room_type")
}

enum BookingStatus {
  pending
  approved
  rejected
  cancelled

  @@map("booking_status")
}

enum BookingType {
  recurring
  one_off

  @@map("booking_type")
}

enum AnnouncementStatus {
  draft
  published

  @@map("announcement_status")
}

enum AnnouncementAudience {
  all
  year1
  year2
  year3
  year4

  @@map("announcement_audience")
}

enum EventType {
  created
  approved
  rejected
  withdrawn
  cancelled
  moved_occurrence
  moved_series
  edited
  occurrence_cancelled

  @@map("event_type")
}

enum NotificationType {
  request_submitted
  request_approved
  request_rejected
  booking_moved
  booking_cancelled_by_instructor
  request_withdrawn

  @@map("notification_type")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique @db.Citext
  passwordHash     String    @map("password_hash")
  name             String
  titlePrefix      String?   @map("title_prefix")
  role             UserRole
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  bookingsInstructing Booking[]      @relation("instructor")
  bookingsRequested   Booking[]      @relation("requestedBy")
  bookingsDecided     Booking[]      @relation("decidedBy")
  defaultForCourses   Course[]
  events              BookingEvent[]
  notifications       Notification[]
  receiptChecks       ReceiptCheck[]
  announcements       Announcement[]

  @@index([role, isActive])
  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Building {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique
  name     String
  isActive Boolean @default(true) @map("is_active")

  rooms Room[]

  @@map("buildings")
}

model Room {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  name       String
  capacity   Int
  roomType   RoomType @map("room_type")
  equipment  String[] @default([])
  isActive   Boolean  @default(true) @map("is_active")

  building    Building            @relation(fields: [buildingId], references: [id])
  bookings    Booking[]
  occurrences BookingOccurrence[]

  @@unique([buildingId, name])
  @@index([buildingId])
  @@index([isActive])
  @@map("rooms")
}

model Course {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String  @unique
  name                String
  defaultInstructorId String? @map("default_instructor_id") @db.Uuid
  isActive            Boolean @default(true) @map("is_active")

  defaultInstructor User?     @relation(fields: [defaultInstructorId], references: [id])
  bookings          Booking[]

  @@map("courses")
}

model Term {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYear Int      @map("academic_year")
  termNumber   Int      @map("term_number") @db.SmallInt
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  isActive     Boolean  @default(false) @map("is_active")

  bookings Booking[]

  @@unique([academicYear, termNumber])
  @@map("terms")
}

model Booking {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestNo    String        @unique @map("request_no")
  status       BookingStatus @default(pending)
  bookingType  BookingType   @map("booking_type")
  termId       String        @map("term_id") @db.Uuid
  courseId     String?       @map("course_id") @db.Uuid
  title        String
  section      String?
  instructorId String        @map("instructor_id") @db.Uuid
  requestedBy  String        @map("requested_by") @db.Uuid
  roomId       String        @map("room_id") @db.Uuid
  dayOfWeek    Int?          @map("day_of_week") @db.SmallInt
  startDate    DateTime?     @map("start_date") @db.Date
  endDate      DateTime?     @map("end_date") @db.Date
  oneOffDate   DateTime?     @map("one_off_date") @db.Date
  startTime    DateTime      @map("start_time") @db.Time(0)
  endTime      DateTime      @map("end_time") @db.Time(0)
  studentCount Int           @map("student_count")
  note         String?
  decidedById  String?       @map("decided_by") @db.Uuid
  decidedAt    DateTime?     @map("decided_at") @db.Timestamptz(6)
  rejectReason String?       @map("reject_reason")
  cancelReason String?       @map("cancel_reason")
  snapshot     Json
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  term          Term                @relation(fields: [termId], references: [id])
  course        Course?             @relation(fields: [courseId], references: [id])
  instructor    User                @relation("instructor", fields: [instructorId], references: [id])
  requester     User                @relation("requestedBy", fields: [requestedBy], references: [id])
  decidedBy     User?               @relation("decidedBy", fields: [decidedById], references: [id])
  room          Room                @relation(fields: [roomId], references: [id])
  occurrences   BookingOccurrence[]
  events        BookingEvent[]
  notifications Notification[]

  @@index([status, createdAt(sort: Desc)])
  @@index([requestedBy, createdAt(sort: Desc)])
  @@index([instructorId])
  @@index([termId])
  @@map("bookings")
}

model BookingOccurrence {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  date        DateTime @db.Date
  startTime   DateTime @map("start_time") @db.Time(0)
  endTime     DateTime @map("end_time") @db.Time(0)
  isCancelled Boolean  @default(false) @map("is_cancelled")
  isBlocking  Boolean  @default(false) @map("is_blocking")
  // `timeslot` tstzrange GENERATED column is added by the raw SQL migration
  // (Prisma cannot express generated range columns).

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id])

  @@index([bookingId])
  @@index([roomId, date])
  @@index([date])
  @@map("booking_occurrences")
}

model BookingEvent {
  id        BigInt    @id @default(autoincrement())
  bookingId String    @map("booking_id") @db.Uuid
  actorId   String    @map("actor_id") @db.Uuid
  eventType EventType @map("event_type")
  oldValue  Json?     @map("old_value")
  newValue  Json?     @map("new_value")
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id])

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  message   String
  bookingId String?          @map("booking_id") @db.Uuid
  payload   Json             @default("{}")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  deliveredEmailAt DateTime? @map("delivered_email_at") @db.Timestamptz(6)
  deliveredLineAt  DateTime? @map("delivered_line_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// Tuition receipt check (once per student per term). Holds the extracted check fields only:
// never the file, never the student's name (the sidecar's `name` field is returned to staff, not stored).
model ReceiptCheck {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String   @map("student_id")
  term          String
  kind          String
  reference     String?
  amount        String?
  paymentStatus String?  @map("payment_status")
  paidAt        String?  @map("paid_at")
  funding       String?
  checks        Json
  verdict       String
  checkedById   String   @map("checked_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkedBy User @relation(fields: [checkedById], references: [id])

  @@unique([studentId, term])
  @@index([reference])
  @@index([term])
  @@map("receipt_checks")
}

model Announcement {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String                @db.VarChar(200)
  content     String                @default("") @db.Text
  audiences   AnnouncementAudience[] @default([])
  status      AnnouncementStatus    @default(draft)
  authorId    String                @map("author_id") @db.Uuid
  publishedAt DateTime?             @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  author User @relation(fields: [authorId], references: [id])

  @@index([status, updatedAt(sort: Desc)])
  @@index([authorId])
  @@map("announcements")
}
