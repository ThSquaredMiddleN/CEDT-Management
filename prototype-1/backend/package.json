{
  "name": "labsync-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test": "vitest run",
    "test:fresh": "tsx --env-file=.env scripts/test-fresh.ts",
    "test:prepare": "tsx --env-file=.env scripts/prepare-test-db.ts",
    "demo:reset": "tsx --env-file=.env scripts/demo-reset.ts",
    "demo:course-change-v2": "tsx --env-file=.env scripts/demo-course-change-v2.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.0",
    "csv-parse": "^7.0.3",
    "fastify": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.2",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
